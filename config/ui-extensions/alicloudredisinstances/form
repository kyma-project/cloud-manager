- path: spec.redisTier
  name: spec.redisTier
  required: true
  description: "Capacity tier can be changed (e.g. S2→S4). Service tier (S↔P) is immutable. Scale-down requires new capacity × 0.8 > used memory."

- path: spec.engineVersion
  name: spec.engineVersion
  required: false
  description: Engine Version is immutable after creation.
  disableOnEdit: true

- path: spec.ipRange
  name: spec.ipRange
  widget: FormGroup
  required: false
  children:
    - path: name
      name: spec.ipRange.name
      widget: Text
      required: true
      disableOnEdit: true

- path: spec.authSecret
  name: spec.authSecret
  widget: FormGroup
  required: false
  children:
    - path: name
      name: spec.authSecret.name
      widget: Text
      required: true
      disableOnEdit: true
    - path: labels
      name: spec.authSecret.labels
      required: false
      widget: KeyValuePair
      disableOnEdit: true
    - path: annotations
      name: spec.authSecret.annotations
      required: false
      widget: KeyValuePair
      disableOnEdit: true
    - path: extraData
      name: spec.authSecret.extraData
      required: false
      widget: KeyValuePair
      disableOnEdit: true
