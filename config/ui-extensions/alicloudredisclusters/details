body:
  - name: configuration
    widget: Panel
    source: spec
    children:
      - name: spec.redisTier
        source: redisTier
        widget: Labels
      - name: spec.shardCount
        source: shardCount
        widget: Labels
      - name: spec.replicasPerShard
        source: replicasPerShard
        widget: Labels
      - name: spec.engineVersion
        source: engineVersion
        widget: Labels

  - name: spec.ipRange
    widget: Panel
    source: spec
    children:
      - name: spec.ipRange.name
        source: ipRange.name
        widget: Labels

  - name: spec.authSecret
    widget: Panel
    source: spec
    children:
      - source: authSecret.name
        name: spec.authSecret.name
        widget: Labels
      - source: authSecret.labels
        name: spec.authSecret.labels
        widget: Labels
      - source: authSecret.annotations
        name: spec.authSecret.annotations
        widget: Labels
      - source: authSecret.extraData
        name: spec.authSecret.extraData
        widget: Labels

  - name: status
    widget: Panel
    source: status
    children:
      - name: status.state
        source: state
        widget: Labels
